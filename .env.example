# After Hours - Environment Configuration

# Parliament API (no key required for public endpoints)
PARLIAMENT_API_BASE_URL=https://members-api.parliament.uk/api

# Companies House API
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_STREAM_KEY=

# Google Gemini
GEMINI_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# DuckDB
DUCKDB_PATH=data/afterhours.duckdb

# Compliance
RISK_SCORE_REVIEW_THRESHOLD=70
AUTO_APPROVE_BELOW=30
